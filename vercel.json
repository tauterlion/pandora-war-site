{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-downloads.cjs",
  "installCommand": "",
  "outputDirectory": "public",
  "trailingSlash": false,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/war-system",
      "destination": "/legacy/war-system.html"
    },
    {
      "source": "/mods",
      "destination": "/legacy/mods.html"
    },
    {
      "source": "/setup",
      "destination": "/legacy/setup.html"
    },
    {
      "source": "/factions",
      "destination": "/legacy/factions.html"
    },
    {
      "source": "/rules",
      "destination": "/legacy/rules.html"
    },
    {
      "source": "/campaign",
      "destination": "/legacy/campaign.html"
    },
    {
      "source": "/objectives",
      "destination": "/legacy/objectives.html"
    },
    {
      "source": "/installation",
      "destination": "/legacy/installation.html"
    }
  ],
  "headers": [
    {
      "source": "/downloads/Pandora-Performance-1.0.0.mrpack",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Pandora-Performance-1.0.0.mrpack\""
        }
      ]
    },
    {
      "source": "/downloads/Pandora-Balanced-1.0.0.mrpack",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Pandora-Balanced-1.0.0.mrpack\""
        }
      ]
    },
    {
      "source": "/downloads/Pandora-Cinematic-1.0.0.mrpack",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Pandora-Cinematic-1.0.0.mrpack\""
        }
      ]
    }
  ]
}

      "destination": "/legacy/factions.html"
    },
    {
      "source": "/rules",
      "destination": "/legacy/rules.html"
    },
    {
      "source": "/campaign",
      "destination": "/legacy/campaign.html"
    },
    {
      "source": "/objectives",
      "destination": "/legacy/objectives.html"
    },
    {
      "source": "/installation",
      "destination": "/legacy/installation.html"
    }
  ]

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "trailingSlash": false,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/war-system",
      "destination": "/legacy/war-system.html"
    },
    {
      "source": "/mods",
